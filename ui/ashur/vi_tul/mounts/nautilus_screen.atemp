{
  "namespace": "nautilus_screen",
  "main_content@container_content.root_panel": {
    "size": [176, 166],
    "$container_name|default": "$container_title",
    "controls": [
      { "extension@rcc-extensions.nautilus_screen": {} },
      {
        "nautilus@screen_content.image_element": {
          "size": [176, 166],
          "uv_size": [176, 166],
          "texture": "$texture",
          "$texture": "assets/advanced_sprites/horse/nautilus.png",
          "variables": [
            {
              "requires": "($container_name = 'entity.zombie_nautilus.name')",
              "$texture": "assets/advanced_sprites/horse/zombie_nautilus.png"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#has_nautilus_armor_and_saddle_slot", // add this so it dosent become visible for other mount uis?
        "binding_name_override": "#visible"
      }
    ]
  }
}
