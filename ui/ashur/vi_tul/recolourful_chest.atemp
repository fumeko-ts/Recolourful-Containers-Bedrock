{
  "namespace": "recolourful_chest",
  "chest@container_content.root_panel": {
    "size": [192, 174],
    "layer": 1,
    "$container_name|default": "$container_title",
    "controls": [
      {
        "chest@screen_content.image_element": {
          "size": [192, 174], // for some unknown reason height was set to 222? no clue why
          "texture": "$texture",
          "controls": [
            {
              "close@global.close_button": {
                "offset": "$close_position",
                "$pressed": "textures/ui/ashur/close_pressed",
                "$default": "textures/ui/ashur/close_default",
                "$hover": "textures/ui/ashur/close_hover"
              }
            }
          ],
          "$close_position|default": [6, 4],
          "$texture": "assets/sprites/chests/small_chest",
          "variables": [
            //entity
            {
              "requires": "($container_name = 'entity.chest_minecart.name')",
              "$texture": "assets/sprites/chests/chest_minecart",
              "$close_position|default": [14, -4]
            },
            {
              "requires": "($container_name = 'entity.chest_boat.name')",
              "$texture": "assets/sprites/chests/chest_boat",
              "$close_position|default": [14, -4]
            },
            {
              "requires": "($container_name = 'entity.chest_raft.name')",
              "$texture": "assets/sprites/chests/chest_raft",
              "$close_position|default": [14, -4]
            },
            //blocks
            {
              "requires": "($container_name = 'container.chestCopper')",
              "$texture": "assets/sprites/chests/copper_chest"
            }
            // eastereggs add here
          ]
        }
      }
    ]
  }
}
