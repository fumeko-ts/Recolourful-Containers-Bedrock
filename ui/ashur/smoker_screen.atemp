{
  "namespace": "smoker_screen",
  "smoker_panel@global.empty_stack": {
    "orientation": "horizontal",
    "anchor_to": "center",
    "anchor_from": "center",
    "min_size": [176, 166],
    "max_size": [360, 166],
    "controls": [
      {
        "recipe_book@recipe_book.recipe_book": {
          "$recipe_filter_control": "crafting_common.furnace_filter_toggle",
          "$tab_stack_controls": [
            {
              "search_tab@recipe_book.recipe_tab_template": {
                "$is_default_active": true,
                "$extra_contents": "crafting_common.search_tab_icon",
                "$toggle_control_name": "search_tab_toggle",
                "$toggle_group_forced_index": "$search_index",
                "$toggle_binding_value": "#is_left_tab_search"
              }
            },
            {
              "food_tab@recipe_book.recipe_tab_template": {
                "$extra_contents": "crafting_common.smoker_food_tab_icon",
                "$toggle_control_name": "food_tab_toggle",
                "$toggle_group_forced_index": "$food_index",
                "$toggle_binding_value": "#is_left_tab_food"
              }
            }
          ]
        }
      },
      {
        "main_smoker_contents@container_common.container_details": {
          "size": [176, 166],
          "$screen_controls": [
            { "common_panel@screen_content.smoker": {} },
            { "extensions@rcc-extensions.smoker_screen": {} },
            {
              "layout_toggle_wrapper@global.empty_panel": {
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": [41, 48],
                "controls": [
                  {
                    "layout_toggle@crafting_common.recipe_layout_toggle": {
                      "anchor_from": "bottom_right",
                      "anchor_to": "bottom_right"
                    }
                  }
                ]
              }
            },
            {
              "smoker_main_content@global.empty_stack": {
                "orientation": "vertical",
                "size": [176, 70],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "controls": [
                  { "filler_0@global.empty_panel": { "size": [176, 16] } },
                  {
                    "main_cell_stacks@global.empty_stack": {
                      "orientation": "horizontal",
                      "size": [176, 54],
                      "controls": [
                        { "filler_1@global.empty_panel": { "size": [55, "fill"] } },
                        {
                          "fuel_and_ingredient_stack@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [18, "fill"],
                            "controls": [
                              {
                                "smoker_smeltable_item@jc_container_item.container_item": {
                                  "$background_control": "crafting_textures.main_cell_panel",
                                  "$item_collection": "furnace_ingredient_items"
                                }
                              },
                              {
                                "fuel_fire_wrapper@global.empty_panel": {
                                  "size": ["fill", 18],
                                  "controls": [
                                    {
                                      "fuel_fire_progress@smoker_screen.smoker_clipping_image_template": {
                                        "offset": [1, 2],
                                        "anchor_to": "top_left",
                                        "anchor_from": "top_left",
                                        "size": [14, 14],
                                        "keep_ratio": true,
                                        "clip_pixelperfect": true,
                                        "texture": "textures/ui/ashur/animations/smoker_burn_lit",
                                        "clip_direction": "down",
                                        "uv_size": [14, 14],
                                        "uv": { "anim_type": "aseprite_flip_book", "initial_uv": [0, 0] },
                                        "$progress_ratio_binding": "#furnace_flame_ratio"
                                      }
                                    }
                                  ]
                                }
                              },
                              {
                                "smoker_burnable_item@jc_container_item.container_item": {
                                  "$item_collection": "furnace_fuel_items"
                                }
                              }
                            ]
                          }
                        },
                        { "filler_5@global.empty_panel": { "size": [6, "fill"] } },
                        {
                          "smoker_arrow_holding_stack@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [24, "fill"],
                            "controls": [
                              { "filler_6@global.empty_panel": { "size": ["fill", 18] } },
                              {
                                "smoker_arrow_progress@smoker_screen.smoker_clipping_image_template": {
                                  "size": [24, 16],
                                  "texture": "assets/sprites/container/smoker/burn_progress",
                                  "clip_direction": "left",
                                  "$progress_ratio_binding": "#furnace_arrow_ratio"
                                }
                              },
                              { "filler_7@global.empty_panel": { "size": ["fill", 20] } }
                            ]
                          }
                        },
                        { "filler_8@global.empty_panel": { "size": [8, "fill"] } },
                        {
                          "output_slot_holding_stack@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [26, "fill"],
                            "controls": [
                              { "filler_9@global.empty_panel": { "size": ["fill", 14] } },
                              {
                                "output_slot_wrapper@global.empty_panel": {
                                  "size": [26, 26],
                                  "controls": [
                                    {
                                      "output_slot_underlay@crafting_textures.main_cell_panel": {
                                        "$item_collection|default": "furnace_output_items"
                                      }
                                    },
                                    {
                                      "output_item_slot@jc_container_item.container_item": {
                                        "anchor_to": "center",
                                        "anchor_from": "center",
                                        "$item_collection": "furnace_output_items"
                                      }
                                    }
                                  ]
                                }
                              },
                              { "filler_10@global.empty_panel": { "size": ["fill", 14] } }
                            ]
                          }
                        },
                        { "filler_11@global.empty_panel": { "size": [39, "fill"] } }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "inventory_and_hotbar@container_common.container_bottom_section": {}
            }
          ]
        }
      }
    ]
  },
  "smoker_clipping_image_template@global.empty_image": {
    "layer": 3,
    "clip_pixelperfect": true,
    "bindings": [
      {
        "binding_name": "$progress_ratio_binding",
        "binding_name_override": "#clip_ratio",
        "binding_condition": "always"
      }
    ]
  }
}
