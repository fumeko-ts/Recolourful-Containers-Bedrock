{
  "namespace": "crafting_screen",
  "screen_base@container_common.container_details": {
    "min_size": [176, 166],
    "max_size": [359, 166],
    "$screen_controls": [
      {
        "base_horizontal_Stack@global.empty_stack": {
          "orientation": "horizontal",
          "anchor_to": "center",
          "anchor_from": "center",
          "min_size": [176, 166],
          "max_size": [359, 166],
          "layer": 1,
          "controls": [
            { "recipe_book@recipe_book.recipe_book": {} },
            {
              "inventory@global.empty_panel": {
                "size": [176, 166],
                "controls": [
                  { "container@screen_content.crafting": {} },
                  { "extensions@rcc-extensions.crafting_screen": {} },
                  {
                    "mobile_craft_holder@global.empty_panel": {
                      "size": [92, 56],
                      "anchor_from": "top_right",
                      "anchor_to": "top_right",
                      "controls": [
                        {
                          "craft_all_mobile": {
                            "type": "button",
                            "default_control": "default",
                            "hover_control": "hover",
                            "pressed_control": "pressed",
                            "anchor_from": "bottom_left",
                            "anchor_to": "bottom_left",
                            "size": [35, 26],
                            "layer": 7,
                            "button_mappings": [
                              {
                                "from_button_id": "button.menu_select",
                                "mapping_type": "pressed",
                                "to_button_id": "button.crafting_output_tertiary"
                              }
                            ],
                            "property_bag": {
                              "#collection_index": 0,
                              "#collection_name": "crafting_output_items"
                            },
                            "controls": [
                              { "default@screen_content.mobile_easy_craft_table_default": {} },
                              { "pressed@screen_content.mobile_easy_craft_table_pressed": {} },
                              { "hover@screen_content.mobile_easy_craft_table_hover": {} }
                            ]
                          }
                        }
                      ],
                      "bindings": [
                        {
                          "binding_name": "#using_touch",
                          "binding_name_override": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "layout_toggle_wrapper@global.empty_panel": {
                      "size": [26, 49],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "controls": [
                        {
                          "recipe_toggle@crafting_common.recipe_layout_toggle": {
                            "anchor_to": "bottom_right",
                            "anchor_from": "bottom_right"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "crafting_stack_wrapper@global.empty_stack": {
                      "orientation": "vertical",
                      "anchor_to": "top_left",
                      "anchor_from": "top_left",
                      "size": [176, 70],
                      "controls": [
                        { "crafting_top_margin@global.empty_panel": { "size": [176, 16] } },
                        {
                          "crafting_body_row@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [176, 54],
                            "controls": [
                              { "filler_0@global.empty_panel": { "size": [29, 54] } },
                              {
                                "crafting_3x3_grid@global.empty_grid": {
                                  "size": [54, 54],
                                  "grid_dimensions": [3, 3],
                                  "$item_collection": "crafting_input_items",
                                  "$background_control": "crafting_textures.main_cell_panel",
                                  "$item_renderer_binding_condition": "always",
                                  "collection_name": "$item_collection",
                                  "grid_item_template": "jc_container_item.container_item"
                                }
                              },
                              {
                                "filler_1@global.empty_panel": { "size": [36, "fill"] }
                              },
                              {
                                "output_stack@global.empty_stack": {
                                  "orientation": "vertical",
                                  "size": [26, 54],
                                  "controls": [
                                    { "output_top_spacing@global.empty_panel": { "size": ["fill", 14] } },
                                    {
                                      "crafting_output_holder@global.empty_panel": {
                                        "size": [26, 26],
                                        "controls": [
                                          {
                                            "underlay@crafting_textures.main_cell_panel": {
                                              "$item_collection|default": "crafting_output_items"
                                            }
                                          },
                                          {
                                            "crafting_output_slot@jc_container_item.container_item": {
                                              "$button_control": "button_mappings.crafting_output_button",
                                              "$item_renderer_binding_condition": "always",
                                              "$item_collection": "crafting_output_items",
                                              "anchor_from": "center",
                                              "anchor_to": "center"
                                            }
                                          }
                                        ]
                                      }
                                    },
                                    { "output_bottom_spacing@global.empty_panel": { "size": ["fill", 14] } }
                                  ]
                                }
                              },
                              { "crafting_stack_right_spacer@global.empty_panel": { "size": [31, "fill"] } }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "inventory_and_hotbar@container_common.container_bottom_section": {}
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
