{
  "namespace": "nautilus_screen",
  "main_content@global.empty_panel": {
    "size": [176, 166],
    "$container_name|default": "$container_title",
    "controls": [
      /*
        redstone chicken stay out of this file ik you been reading these if your going to yoink my code again atleast credit me this time
      */
      {
        "nautilus@screen_content.image_element": {
          "size": [176, 166],
          "uv_size": [176, 166],
          "texture": "$texture",
          "$texture": "assets/variants/mounts/nautilus.png",
          "variables": [
            {
              "requires": "($container_name = 'entity.zombie_nautilus.name')",
              "$texture": "assets/variants/mounts/zombie_nautilus.png"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#has_nautilus_armor_and_saddle_slot", // add this so it dosent become visible for other mount uis?
        "binding_name_override": "#visible"
      }
    ]
  }
}
