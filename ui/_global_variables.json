{
  //used for compatibility
  "$is_recolourful_containers": true,
  "$_pack_name": "recolourful",
  //set UI transparency
  "$container_opacity": 1,
  "$background_blur_opacity": 0.4, //the base png is transparent

  //if true forces the container close buttons to render no matter the input type
  "$show_exit_buttons": false,
  //if true allows pc users to trigger the page buttons useing the scroll wheel
  "$use_experimental_recipe_scroll_input": false,
  //if true allows the user to hover over a tab to auto select it
  "$use_experimental_tab_toggle_input": false,
  //if false it will remove the container open animation
  "$use_container_ui_animations": true,
  //if true will unlock villager trades
  "$use_unlocked_villager_trades": false,
  //if true removes the empty bundle text and makes the bundle ui more compact
  "$use_slim_bundle_tooltips": true,

  
  //title text color
  "$container_title_color": [0.247, 0.247, 0.247],

  //these item indexes are whats used to render the items in the recipe book tabs
  //you can find the index for a item useing this --> https://www.planetminecraft.com/texture-pack/item-id-visualizer-mcbe-mcpe/
  //item_index = (#item_id_aux / 65536)

  //creative inventory tabs
  "$chest_item_index": 54,
  "$redstone_item_index": 376,
  "$iron_sword_item_index": 309,
  "$purple_froglight_item_index": -469,
  "$bricks_item_index": 45,

