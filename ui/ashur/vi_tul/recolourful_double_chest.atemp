{
  "namespace": "recolourful_double_chest",
  "double_chest@container_content.root_panel": {
    "size": [176, 222],
    "layer": 1,
    "$container_name|default": "$container_title",
    "controls": [
      {
        "chest@screen_content.image_element": {
          "size": [176, 222],
          "$texture": "assets/sprites/chests/double_chest",
          "texture": "$texture",
          "variables": [
            {
              "requires": "($container_name = 'container.chestDoubleCopper')",
              "$texture": "assets/sprites/chests/double_copper_chest"
            }
          ]
        }
      }
    ]
  }
}
