{
  "namespace": "recolourful_hover_text",
  "hover_text_renderer@global.empty_panel": {
    "ignored": "$dont_render_hover_text",
    "layer": 290,
    "size": [18, 18],
    "controls": [
      /*
        redstone chicken stay out of this file ik you been reading these if your going to yoink my code again atleast credit me this time
      */
      {
        "custom_hover_text_renderer@global.custom_renderer": {
          "allow_clipping": false,
          "$type": "bundle_tooltip_renderer",
          "controls": [
            {
              "hover_text_wrapper@global.empty_panel": {
                "size": ["200%c", "200%c"],
                "controls": [
                  {
                    "items_with_rarity@recolourful_hover_text.tooltip_base": {}
                  }
                ],
                "bindings": [
                  {
                    "binding_name": "(not #show_bundle_tooltip_hover)",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "binding_condition": "always",
              "resolve_sibling_scope": true, //locks source_control_name to the closest control with the provided name (used if there will be sevral controls with the same name)
              "source_control_name": "hover_text_label",
              "source_property_name": "(not ($hover_text_binding_name = ''))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ],
    "bindings": "$hover_text_visibility_bindings"
  },
  "tooltip_base@global.empty_image": {
    "size": ["100%c + 10px", "100%c + 8px"],
    "nineslice_size": 3,
    "offset": "$tooltip_offset",
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "allow_debug_missing_texture": false,
    "texture": "#texture",
    "controls": [    
      // {
      //   "holder@global.empty_stack": {
      //     "orientation": "horizontal",
      //     "size": ["100%c", "100%cm"],
      //     "controls": [
      //       {
      //         "small_item_renderer@global.empty_panel": {
      //           "size": [12, 10],
      //           "controls": [
      //             {
      //               "item_renderer@jc_container_item.item_renderer": {
      //                 "anchor_from": "top_left",
      //                 "anchor_to": "top_left",
      //                 "offset": [-1, 0.5],
      //                 "size": [10, 10]
      //               }
      //             }
      //           ]
      //         }
      //       },
      //       {
      //         "hover_text_label@recolourful_hover_text.hover_text_label_template": {
      //           "text": "$hover_text_binding_name",
      //           "bindings": [
      //             {
      //               "binding_type": "collection",
      //               "binding_collection_name": "$item_collection",
      //               "binding_name": "$hover_text_binding_name"
      //             }
      //           ]
      //         }
      //       }
      //     ]
      //   }
      // }
      {
        "hover_text_label@recolourful_hover_text.hover_text_label_template": {
          "text": "$hover_text_binding_name",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection",
              "binding_name": "$hover_text_binding_name"
            }
          ]
        }
      }
    ],
    "property_bag": {
      "#item_rarity_§e": "textures/uncommon",
      "#item_rarity_§b": "textures/rare",
      "#item_rarity_§d": "textures/epic",
      "#item_rarity_": "textures/common" //removed  - '§f' since i dont want 2 duplicates
    },
    "bindings": [
      {
        "binding_type": "view",
        "binding_condition": "always",
        "resolve_sibling_scope": true,
        "source_control_name": "hover_text_label",
        //gets the first 3 bytes from the provided string and removes the renamed color code.
        "source_property_name": "('%.3s' * ($hover_text_binding_name - '§o'))",
        "target_property_name": "#first_3_bytes"
      },
      {
        "binding_type": "view",
        "binding_condition": "always",
        //remove all known color codes so if it = 'abc' it will output 'abc' if it equals '§b' it will output ''
        "source_property_name": "(#first_3_bytes - '§e' - '§b' - '§d')",
        "target_property_name": "#leftovers"
      },
      {
        "binding_type": "view",
        "binding_condition": "always",
        //get's the first 3 bytes and takes away whats left inside #leftovers
        //and resolve's #item_rarity_*.
        //if #leftovers = 'abc' it will take it awway from first 3 bytes and resolve #item_rarity_ wich is textures/common
        "source_property_name": "('#item_rarity_' + (#first_3_bytes - #leftovers))",
        "target_property_name": "#texture"
      }
    ]
  },
  "bundle_tooltip@recolourful_hover_text.tooltip_base": {
    "layer": 5,
    "anchor_to": "bottom_middle",
    "anchor_from": "top_middle",
    "offset": [0, 1],

    "controls": [
      {
        "hover_text_label@recolourful_hover_text.hover_text_label_template": {
          "text": "#selected_bundle_item_text",
          "bindings": [
            {
              "binding_name": "#selected_bundle_item_text",
              "binding_condition": "visible"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "binding_condition": "always",
        "resolve_sibling_scope": true,
        "source_control_name": "hover_text_label",
        "source_property_name": "('%.3s' * (#selected_bundle_item_text - '§o'))",
        "target_property_name": "#first_3_bytes"
      },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "(#first_3_bytes - '§e' - '§b' - '§d')",
        "target_property_name": "#leftovers"
      },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "('#item_rarity_' + (#first_3_bytes - #leftovers))",
        "target_property_name": "#texture"
      }
    ]
  },

  "touch_tooltip_base@global.empty_panel": {
    "size": ["100%c", "100%c"],
    "controls": [
      {
        //we wrap this inside a seprate control since if its directly reffrenced by the parent factory the top level bindings will break
        "tooltip@recolourful_hover_text.tooltip_base": {
          "offset": [0, -25],
          "alpha": {
            "anim_type": "alpha",
            "easing": "in_quint",
            "destroy_at_end": "touch_tooltip_base",
            "duration": 2,
            "from": 1.0,
            "to": 0
          },
          "propagate_alpha": true, //applies alpha value to child control
          "controls": [
            {
              "hover_text@recolourful_hover_text.hover_text_label_template": {
                "text": "#selected_hover_text"
              }
            }
          ],
          "bindings": [
            { "binding_name": "#selected_hover_text" },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "('%.3s' * (#selected_hover_text - '§o'))",
              "target_property_name": "#first_3_bytes"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "(#first_3_bytes - '§e' - '§b' - '§d')",
              "target_property_name": "#leftovers"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "('#item_rarity_' + (#first_3_bytes - #leftovers))",
              "target_property_name": "#texture"
            }
          ]
        }
      }
    ]
  },
  "hover_text_label_template": {
    "type": "label",
    "size": ["default", "default"],
    "layer": 30,
    "shadow": "$use_tooltip_text_shadow"
  }
}
