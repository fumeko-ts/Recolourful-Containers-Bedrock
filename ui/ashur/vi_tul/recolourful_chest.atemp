{
  "namespace": "recolourful_chest",
  "chest@screen_content.image_element": {
    "size": [192, 174],
    "offset": [0, 166],
    "texture": "$texture",
    "$container_name|default": "$container_title",
    "$texture": "assets/variants/chests/small_chest",
    "anchor_to": "bottom_middle",
    "anchor_from": "top_middle",
    "$close_button_offset|default": [6, 4],
    "controls": [
      {
        "close_button@global.close_button": {}
      }
    ],
    /*
      redstone chicken stay out of this file ik you been reading these if your going to yoink my code again atleast credit me this time
    */
    "variables": [
      //entity
      {
        "requires": "($container_name = 'entity.chest_minecart.name')",
        "$close_button_offset|default": [14, -4],
        "$texture": "assets/variants/chests/chest_minecart"
      },
      {
        "requires": "($container_name = 'entity.chest_boat.name')",
        "$close_button_offset|default": [14, -4],
        "$texture": "assets/variants/chests/chest_boat"
      },
      {
        "requires": "($container_name = 'entity.chest_raft.name')",
        "$close_button_offset|default": [14, -4],
        "$texture": "assets/variants/chests/chest_raft"
      },
      //blocks
      {
        "requires": "($container_name = 'container.chestCopper')",
        "$texture": "assets/variants/chests/copper_chest"
      }
      // eastereggs add here
    ]
  }
}
