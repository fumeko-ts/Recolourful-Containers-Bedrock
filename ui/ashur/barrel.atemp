{
  "namespace": "barrel",
  "barrel@container_common.container_details": {
    "size": [176, 166],
    "$screen_controls": [
      { "extension@rcc-extensions.barrel": {} },
      { "common_panel@container_content.barrel_screen": {} },
      {
        "close@global.close_button": {
          "offset": [14, -4],
          "$pressed": "textures/ui/ashur/close_pressed",
          "$default": "textures/ui/ashur/close_default",
          "$hover": "textures/ui/ashur/close_hover"
        }
      },
      {
        "barrel_top_half@global.empty_stack": {
          "orientation": "vertical",
          "size": [176, 77],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "controls": [
            { "filler@global.empty_panel": { "size": [176, 17] } },
            {
              "barrel_grid_holder@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 54],
                "controls": [
                  { "filler_3@global.empty_panel": { "size": [7, "fill"] } },
                  {
                    "barrel_grid": {
                      "type": "grid",
                      "size": [162, 54],
                      "grid_dimensions": [9, 3],
                      "$item_collection": "container_items",
                      "collection_name": "$item_collection",
                      "grid_item_template": "container_item.container_item"
                    }
                  },
                  { "filler_4@global.empty_panel": { "size": [7, "fill"] } }
                ]
              }
            }
          ]
        }
      },
      {
        "bottom_section@global.container_bottom_section": {}
      }
    ]
  }
}
