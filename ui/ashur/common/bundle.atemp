{
  "namespace": "bundle",
  "bundle_tooltip@global.root_panel": {
    "size": ["100%cm", "100%cm"],
    "offset": [0, -6],
    "layer": 40,
    "$is_item_slot|default": false,
    "controls": [
      {
        "close_button": {
          "type": "button",
          "size": [20, 20],
          "offset": [3, 0],
          "anchor_from": "top_right",
          "anchor_to": "top_left",
          "default_control": "default",
          "hover_control": "hover",
          "pressed_control": "pressed",
          "sound_name": "random.click",
          "sound_volume": 1.0,
          "sound_pitch": 1.0,
          "button_mappings": [
            { "to_button_id": "button.hide_bundle_tooltip", "mapping_type": "pressed" },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.hide_bundle_tooltip",
              "mapping_type": "focused"
            },
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.hide_bundle_tooltip",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_up",
              "to_button_id": "button.hide_bundle_tooltip",
              "mapping_type": "global"
            }
          ],
          "controls": [
            { "default@global.empty_image": { "texture": "textures/ui/ashur/close_default.png" } },
            { "hover@global.empty_image": { "texture": "textures/ui/ashur/close_hover.png" } },
            { "pressed@global.empty_image": { "texture": "textures/ui/ashur/close_pressed.png" } }
          ],
          "bindings": [
            {
              "binding_name": "#show_bundle_tooltip_pocket",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "tooltip@recolourful_bundle.colors": {
          "size": ["100%cm", "100%c"],
          "nineslice_size": 4,
          "uv_size": [32, 32],
          "controls": [
            {
              "bundle_tooltip_factory@global.empty_collection": {
                "size": ["100%sm - 2px", 1],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "collection_name": "bundle_tooltip_collection",
                "factory": {
                  "name": "bundle_tooltip_factory",
                  "max_children_size": 1,
                  "control_name": "@recolourful_hover_text.bundle_tooltip"
                },
                "bindings": [
                  {
                    "binding_name": "(#bundle_has_selected_item * 1)",
                    "binding_name_override": "#collection_length"
                  }
                ]
              }
            },
            {
              "bundle_progress_bar_border@global.empty_image": {
                "texture": "textures/bundles/empty_stack_progress_bar.png",
                "size": ["100%sm - 10px", 12],
                "min_size": [72, 12],
                "nineslice_size": 2,
                "anchor_from": "bottom_middle",
                "anchor_to": "top_middle",
                "offset": [0, -18],
                "layer": 3,
                "alpha": 0.5,

                "controls": [
                  {
                    "bundle_fill_progress_bar@bundle.bundle_bar_template": {
                      "texture": "textures/bundles/bundle_progress",
                      "clip_direction": "left",
                      "controls": [
                        {
                          "percent": {
                            "type": "label",
                            "size": ["default", 10],
                            "layer": 4,
                            "anchor_from": "center",
                            "anchor_to": "center",
                            "text": "#text",
                            "shadow": true,
                            "bindings": [
                              {
                                "binding_name": "#bundle_weight_bar_ratio",
                                "binding_condition": "always_when_visible"
                              },
                              {
                                "binding_type": "view",
                                "binding_condition": "always_when_visible",
                                "source_property_name": "(100 - (#bundle_weight_bar_ratio * 100))",
                                "target_property_name": "#bundle_percent_float"
                              },
                              {
                                "binding_type": "view",
                                "binding_condition": "always_when_visible",
                                "source_property_name": "((#bundle_percent + (not (#bundle_percent_float - #bundle_percent < 1))) - (#bundle_percent_float - #bundle_percent < 0) * 1)",
                                "target_property_name": "#bundle_percent"
                              },
                              {
                                "binding_type": "view",
                                "binding_condition": "always_when_visible",
                                "source_property_name": "('\u00a7z' + #bundle_percent + '%%')",
                                "target_property_name": "#text"
                              },
                              {
                                "binding_name": "(not #is_selected_bundle_empty)",
                                "binding_name_override": "#visible"
                              }
                            ]
                          }
                        }
                      ],
                      "bindings": [
                        {
                          "binding_name": "#bundle_weight_bar_ratio",
                          "binding_name_override": "#clip_ratio",
                          "binding_condition": "always_when_visible"
                        }
                      ]
                    }
                  },
                  {
                    "bundle_full_progress_bar@bundle.bundle_bar_template": {
                      "texture": "textures/bundles/bundle_full_progress",
                      // "controls": [
                      //   { "bundle_full_label@bundle.bundle_label_template": { "text": "item.bundle.full" } }
                      // ],
                      "bindings": [
                        {
                          "binding_name": "#is_selected_bundle_full",
                          "binding_name_override": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "bundle_empty_label@bundle.bundle_label_template": {
                      "text": "item.bundle.empty",
                      "shadow": false,
                      "bindings": [
                        {
                          "binding_name": "#is_selected_bundle_empty",
                          "binding_name_override": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "bundle_main_content_wrapper@global.empty_stack": {
                "size": ["100%cm + 10px", "100%c + 10px"],
                "layer": 2,
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [5, 4],
                "orientation": "vertical",
                "controls": [
                  {
                    "bundle_title_label@bundle.bundle_label_template": {
                      "text": "#bundle_name",
                      "localize": false,
                      "bindings": [
                        {
                          "binding_name": "#bundle_name",
                          "binding_condition": "always_when_visible"
                        }
                      ]
                    }
                  },
                  { "spacer_0@global.empty_panel": { "size": ["100%sm", 3] } },
                  {
                    "bundle_center_content@global.empty_panel": {
                      "size": ["100%sm", "100%c"],
                      "controls": [
                        {
                          "bundle_item_grid": {
                            "type": "grid",
                            "size": ["default", "default"],
                            "layer": 3,
                            "anchor_from": "center",
                            "anchor_to": "center",
                            "$item_collection": "bundle_items",
                            "grid_dimension_binding": "#bundle_tooltip_grid_dimensions",
                            "collection_name": "$item_collection",
                            "grid_item_template": "bundle.bundle_slot_item",
                            "bindings": [
                              {
                                "binding_name": "#bundle_tooltip_grid_dimensions",
                                "binding_condition": "always_when_visible"
                              },
                              {
                                "binding_name": "(not #is_selected_bundle_empty)",
                                "binding_name_override": "#visible"
                              }
                            ]
                          }
                        },
                        {
                          "bundle_empty@bundle.bundle_label_template": {
                            "color": [0.659, 0.659, 0.659],
                            "text": "item.bundle.empty.description",
                            "size": [72, "default"],
                            "anchor_from": "center",
                            "anchor_to": "center",
                            "ignored": "$use_slim_bundle_tooltips",
                            "bindings": [
                              {
                                "binding_name": "#is_selected_bundle_empty",
                                "binding_name_override": "#visible"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  { "spacer_1@global.empty_panel": { "size": [72, 2] } }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "bundle_bar_template@global.empty_image": {
    "layer": 2,
    "nineslice_size": 2,
    "size": ["100%", 12]
  },
  //dosent use global.empty_label because if its a number it will break
  "bundle_label_template": {
    "type": "label",
    "size": ["default", 10],
    "layer": 3,
    "localize": true,
    "shadow": true
  },

  //tooltip grid items
  "bundle_slot_item@jc_container_item.container_item": {
    "size": [18, 18],
    "$background_control": "bundle.bundle_item_slot_content",
    "$button_control": "button_mappings.bundle_item_slot_button"
  },
  "bundle_item_slot_content@global.empty_panel": {
    "size": [18, 18],
    "controls": [
      {
        "bundle_slot_highlight@recolourful_bundle.colors": {
          "size": [18, 18],
          "uv": [40, 0],
          "uv_size": [18, 18],
          "layer": 1,
          "$is_item_slot": true,
          "controls": [
            {
              "bundle_cell_image@global.empty_panel": {
                "controls": [
                  {
                    "highlight_slot@global.empty_image": {
                      "texture": "textures/slot_highlight_back.png",
                      "layer": 4
                    }
                  },
                  {
                    "highlight_slot_overlay@global.empty_image": {
                      "texture": "textures/slot_highlight_front.png",
                      "layer": 16
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_name": "#is_selected_bundle_item_slot",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "bundle_more_items_count": {
          "type": "label",
          "size": ["default", 10],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 3,
          "text": "#more_hidden_items_text",
          "shadow": true,
          "bindings": [
            {
              "binding_name": "#is_hidden_items_label",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection"
            },
            {
              "binding_name": "#more_hidden_items_text",
              "binding_condition": "visible"
            }
          ]
        }
      }
    ]
  }
}
