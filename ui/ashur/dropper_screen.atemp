{
  "namespace": "dropper_screen",
  "dropper_panel@container_common.container_details": {
    "size": [176, 166],
    "$screen_controls": [
      { "common_panel@screen_content.dropper": {} },
      { "extensions@rcc-extensions.dropper_screen": {} },
      {
        "redstone@screen_content.image_element": {
          "size": [176, 77],
          "uv_size": [176, 77],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 2,
          "texture": "textures/ui/ashur/animations/dropper",
          "uv": { "anim_type": "aseprite_flip_book", "initial_uv": [0, 0] },
          "controls": [
            {
              "4@dropper_screen.dropper_piston_template": {
                "size": [16, 32],
                "uv_size": [16, 32],
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "offset": [-28, 19],
                "texture": "assets/variants/animated/dropper/piston_1",
                "uv": "@dropper_pistons.piston_10"
              }
            },
            {
              "6@dropper_screen.dropper_piston_template": {
                "size": [32, 16],
                "uv_size": [32, 16],
                "offset": [-28, -8],
                "anchor_from": "bottom_right",
                "anchor_to": "bottom_right",
                "texture": "assets/variants/animated/dropper/piston_2",
                "uv": "@dropper_pistons.piston_20"
              }
            }
          ]
        }
      },
      {
        "dropper_top_half@global.empty_stack": {
          "orientation": "vertical",
          "size": [176, 70],
          "anchor_to": "top_middle",
          "anchor_from": "top_middle",
          "controls": [
            { "filler_1@global.empty_panel": { "size": ["fill", 6] } },
            {
              "dropper_main_content@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 64],
                "controls": [
                  { "filler_2@global.empty_panel": { "size": [61, "fill"] } },
                  {
                    "label_and_grid_holder@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [54, 64],
                      "controls": [
                        { "filler_0@global.empty_panel": { "size": [54, 10] } },
                        {
                          "dropper_item_input@global.empty_grid": {
                            "size": [54, 54],
                            "grid_dimensions": [3, 3],
                            "$item_collection": "container_items",
                            "collection_name": "$item_collection",
                            "grid_item_template": "jc_container_item.container_item"
                          }
                        }
                      ]
                    }
                  },
                  { "filler_3@global.empty_panel": { "size": [61, "fill"] } }
                ]
              }
            }
          ]
        }
      },
      {
        "inventory_and_hotbar@container_common.container_bottom_section": {}
      }
    ]
  },
  "dropper_piston_template@screen_content.image_element": {
    "uv": [0, 0],
    "animation_reset_name": "screen_animation_reset",
    "disable_anim_fast_forward": true,
    "layer": 2
  }
}
