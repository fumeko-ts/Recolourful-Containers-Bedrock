{
  "namespace": "crafter_screen",
  "crafter_panel@container_common.container_details": {
    "size": [176, 166],
    "$screen_controls": [
      { "common_panel@screen_content.crafter": {} },
      { "extensions@rcc-extensions.crafter_screen": {} },
      {
        "redstone_activated_flicker@global.empty_panel": {
          "size": [174, 6],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 2,
          "offset": [0, 1],
          "controls": [
            {
              "deactivated@crafter_screen.redstone_animated_texture": {
                "uv": [0, 0],
                "uv_size": [174, 6],
                "$binding_value": "textures/ui/redstone_arrow_unpowered",
                "variables": {
                  "requires": "$pocket_screen",
                  "$binding_value": "textures/ui/redstone_arrow_vertical_unpowered"
                }
              }
            },
            {
              "activated@crafter_screen.redstone_animated_texture": {
                "uv": [0, 6],
                "uv_size": [174, 6],
                "$binding_value": "textures/ui/redstone_arrow_powered",
                "variables": {
                  "requires": "$pocket_screen",
                  "$binding_value": "textures/ui/redstone_arrow_vertical_powered"
                }
              }
            }
          ]
        }
      },
      {
        "main_vertical_stack@global.empty_stack": {
          "orientation": "vertical",
          "size": [176, 70],
          "anchor_to": "top_middle",
          "anchor_from": "top_middle",
          "controls": [
            { "vertical_filler_top@global.empty_panel": { "size": ["fill", 16] } },
            {
              "input_and_output_row@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 54],
                "controls": [
                  { "input_left_filler@global.empty_panel": { "size": [25, "fill"] } },
                  {
                    "crafter_items@global.empty_grid": {
                      "size": [54, 54],
                      "grid_dimensions": [3, 3],
                      "$item_collection": "container_items",
                      "collection_name": "$item_collection",
                      "controls": [
                        {"slot_button_0@crafter_screen.crafter_grid_item": {"grid_position": [0, 0],"$crafter_button_index": 0}},
                        {"slot_button_1@crafter_screen.crafter_grid_item": {"grid_position": [1, 0],"$crafter_button_index": 1}},
                        {"slot_button_2@crafter_screen.crafter_grid_item": {"grid_position": [2, 0],"$crafter_button_index": 2}},
                        {"slot_button_3@crafter_screen.crafter_grid_item": {"grid_position": [0, 1],"$crafter_button_index": 3}},
                        {"slot_button_4@crafter_screen.crafter_grid_item": {"grid_position": [1, 1],"$crafter_button_index": 4}},
                        {"slot_button_5@crafter_screen.crafter_grid_item": {"grid_position": [2, 1],"$crafter_button_index": 5}},
                        {"slot_button_6@crafter_screen.crafter_grid_item": {"grid_position": [0, 2],"$crafter_button_index": 6}},
                        {"slot_button_7@crafter_screen.crafter_grid_item": {"grid_position": [1, 2],"$crafter_button_index": 7}},
                        {"slot_button_8@crafter_screen.crafter_grid_item": {"grid_position": [2, 2],"$crafter_button_index": 8}}
                      ]
                    }
                  },
                  { "input_right_filler@global.empty_panel": { "size": [34, "fill"] } },
                  {
                    "output_stack@global.empty_stack": {
                      "orientation": "horizontal",
                      "size": [63, 54],
                      "controls": [
                        { "output_right_filler@global.empty_panel": { "size": [20, "fill"] } },
                        {
                          "output_vertical_stack@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [18, 54],
                            "controls": [
                              { "output_top_filler@global.empty_panel": { "size": ["fill", 18] } },
                              {
                                "crafter_output_button": {
                                  "type": "button",
                                  "hover_control": "hover",
                                  "size": [18, 18],
                                  "default_focus_precedence": 1,
                                  "focus_enabled": "$game_pad",
                                  "focus_wrap_enabled": false,
                                  "focus_magnet_enabled": false,
                                  "controls": [
                                    {
                                      "hover@global.hover_text": {
                                        "$hover_text": "#crafting_preview_info"
                                      }
                                    },
                                    {
                                      "output_item_renderer@jc_container_item.item_renderer": {
                                        "$item_collection|default": "crafter_output_item",
                                        "bindings": [
                                          {
                                            "binding_name": "#crafter_output_item",
                                            "binding_name_override": "#item_id_aux"
                                          },
                                          {
                                            "binding_name": "#crafter_output_item_color",
                                            "binding_name_override": "#item_custom_color"
                                          },
                                          {
                                            "binding_name": "#crafter_output_item_shield_base_color_hovered",
                                            "binding_name_override": "#shield_base_color"
                                          },
                                          {
                                            "binding_name": "#crafter_output_item_banner_patterns",
                                            "binding_name_override": "#banner_patterns"
                                          },
                                          {
                                            "binding_name": "#crafter_output_item_selected_banner_colors",
                                            "binding_name_override": "#banner_colors"
                                          },
                                          {
                                            "binding_name": "#crafter_output_item_selected_banner_type",
                                            "binding_name_override": "#banner_type"
                                          },
                                          {
                                            "binding_name": "#crafter_output_item_selected_decorated_pot_sherds",
                                            "binding_name_override": "#decorated_pot_sherds"
                                          }
                                        ]
                                      }
                                    },
                                    {
                                      "output_stack_count_label": {
                                        "type": "label",
                                        "layer": 20,
                                        "offset": [0, 1],
                                        "anchor_to": "bottom_right",
                                        "anchor_from": "bottom_right",
                                        "shadow": true,
                                        "text": "#inventory_stack_count",
                                        "bindings": [
                                          {
                                            "binding_name": "#output_stack_count",
                                            "binding_name_override": "#inventory_stack_count"
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                }
                              },
                              { "output_bottom_filler@global.empty_panel": { "size": ["fill", 18] } }
                            ]
                          }
                        },
                        { "output_right_filler@global.empty_panel": { "size": [25, "fill"] } }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "inventory_and_hotbar@container_common.container_bottom_section": {}
      }
    ]
  },
  "redstone_animated_texture@screen_content.image_element": {
    "texture": "assets/sprites/container/crafter/powered_redstone.png",
    "size": [174, 6],
    "bindings": [
      {
        "binding_condition": "always",
        "binding_name": "(#redstone_arrow_texture = $binding_value)",
        "binding_name_override": "#visible"
      }
    ]
  },
  "crafter_grid_item@global.empty_panel": {
    "size": [18, 18],
    "controls": [
      {
        "crafter_item@jc_container_item.container_item": {
          "$background_control": "crafter_screen.disabled_button_overlay",
          "$button_binding|default": "('#button_visible' + $crafter_button_index)",
          "$disabled_button_action|default": "('disabled_button' + $crafter_button_index)",
          "$crafter_button_mappings|default": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "$disabled_button_action",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_secondary_select",
              "to_button_id": "$disabled_button_action",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "$disabled_button_action",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.controller_select",
              "to_button_id": "$disabled_button_action",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.controller_secondary_select",
              "to_button_id": "$disabled_button_action",
              "mapping_type": "pressed"
            }
          ],
          "$hover_text_visibility_bindings": [
            { "binding_name": "$button_binding" },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "(not $button_binding)",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "disabled_button_overlay": {
    "type": "button",
    "size": [18, 18],
    "layer": 11,
    "sound_volume": 1.0,
    "sound_pitch": 1.0,
    "sound_name": "random.click",
    "always_listen_to_input": true,
    "consume_hover_events": false,
    "default_focus_precedence": 1,
    "focus_enabled": "$game_pad",
    "focus_wrap_enabled": false,
    "focus_magnet_enabled": false,
    "bindings": [{ "binding_name": "$button_binding", "binding_name_override": "#visible" }],
    "controls": [{ "button_texture@screen_content.crafter_disabled_slot": {} }],
    "button_mappings": "$crafter_button_mappings"
  }
}
