{
  "namespace": "barrel_screen",
  "barrel@container_common.container_details": {
    "size": [176, 166],
    "$screen_controls": [
      { "common_panel@screen_content.barrel": {} },
      { "extensions@rcc-extensions.barrel_screen": {} },
      {
        "barrel_top_half@global.empty_stack": {
          "orientation": "vertical",
          "size": [176, 77],
          "anchor_to": "top_middle",
          "anchor_from": "top_middle",
          "controls": [
            { "filler_0@global.empty_panel": { "size": [176, 17] } },
            {
              "barrel_grid_holder@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 54],
                "controls": [
                  { "filler_3@global.empty_panel": { "size": [7, "fill"] } },
                  {
                    "barrel_grid@global.empty_grid": {
                      "size": [162, 54],
                      "grid_dimensions": [9, 3],
                      "grid_item_template": "jc_container_item.container_item",
                      "$item_collection": "container_items",
                      "collection_name": "$item_collection"
                    }
                  },
                  { "filler_4@global.empty_panel": { "size": [7, "fill"] } }
                ]
              }
            }
          ]
        }
      },
      {
        "inventory_and_hotbar@container_common.container_bottom_section": {}
      }
    ]
  }
}
