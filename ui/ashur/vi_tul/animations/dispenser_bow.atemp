{
  "namespace": "dispenser_bow",
  "bow_uv_template": {
    "anim_type": "uv",
    "from": "$frame",
    "to": "$frame",
    "easing": "in_out_sine",
    "duration": "$frame_time",
    "next": "('@dispenser_bow.' + $next_frame)"
  },
  "bow_20@dispenser_bow.bow_uv_template": { "$frame": [0, 0]   , "$next_frame": "bow_21" , "$frame_time": 8   },
  "bow_21@dispenser_bow.bow_uv_template": { "$frame": [0, 68]  , "$next_frame": "bow_22" , "$frame_time": 0.1 },
  "bow_22@dispenser_bow.bow_uv_template": { "$frame": [0, 136] , "$next_frame": "bow_23" , "$frame_time": 1   },
  "bow_23@dispenser_bow.bow_uv_template": { "$frame": [0, 68]  , "$next_frame": "bow_20" , "$frame_time": 0.1 }
}