{
  "namespace": "saddle_misc",
  "main_content@global.empty_panel": {
    "size": [176, 166],
    "controls": [
      /*
        redstone chicken stay out of this file ik you been reading these if your going to yoink my code again atleast credit me this time
      */
      {
        "not_chested@screen_content.image_element": {
          "size": [176, 166],
          "uv_size": [176, 166],
          "texture": "assets/variants/mounts/saddle.png",
          "bindings": [
            {
              "binding_name": "(not #is_chested)",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "chested@screen_content.image_element": {
          "size": [176, 166],
          "uv_size": [176, 166],
          "texture": "assets/variants/mounts/saddle_chested.png",
          "bindings": [
            {
              "binding_name": "#is_chested",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ],
    "bindings": [
      { "binding_name": "#has_saddle_slot" },
      { "binding_name": "#has_nautilus_armor_and_saddle_slot" },
      { "binding_name": "#has_horse_armor_and_saddle_slot" },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "(#has_saddle_slot and (not #has_nautilus_armor_and_saddle_slot) and (not #has_horse_armor_and_saddle_slot))",
        "target_property_name": "#visible"
      }
    ]
  }
}
