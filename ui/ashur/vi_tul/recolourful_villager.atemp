{
  "namespace": "recolourful_villager",
  "villager_panel@container_content.root_panel": {
    "size": [276, 166],
    "layer": 1,
    "$profession|default": "none",
    "controls": [
      /*
        redstone chicken stay out of this file ik you been reading these if your going to yoink my code again atleast credit me this time
      */
      {
        "villager_renamed@screen_content.image_element": {
          "size": [276, 166],
          "uv_size": [276, 166],
          "layer": 1,
          "texture": "assets/sprites/villager/villager"
          // for now i am just underlaying this because useing this binding makes the screen flicker with no texture on first load 
          //,
          // "bindings": [
          //   {
          //     "binding_type": "view",
          //     "source_control_name": "profession_bindings",
          //     "source_property_name": "#is_renamed",
          //     "target_property_name": "#visible"
          //   }
          // ]
        }
      },
      {
        "profession_bindings@screen_content.image_element": {
          "size": [276, 166],
          "uv_size": [276, 166],
          "layer": 2,
          "texture": "#texture",
          "allow_debug_missing_texture": false,
          "property_bag": {
            "#profession_id::ws:": "assets/sprites/villager/weapon",
            "#profession_id::ar:": "assets/sprites/villager/armor",
            "#profession_id::bt:": "assets/sprites/villager/butcher",
            "#profession_id::ct:": "assets/sprites/villager/cartographer",
            "#profession_id::cl:": "assets/sprites/villager/cleric",
            "#profession_id::fr:": "assets/sprites/villager/farmer",
            "#profession_id::fs:": "assets/sprites/villager/fisherman",
            "#profession_id::fl:": "assets/sprites/villager/fletcher",
            "#profession_id::lt:": "assets/sprites/villager/leather",
            "#profession_id::lb:": "assets/sprites/villager/librarian",
            "#profession_id::ms:": "assets/sprites/villager/mason",
            "#profession_id::sh:": "assets/sprites/villager/shepherd",
            "#profession_id::tl:": "assets/sprites/villager/tool"
          },
          "bindings": [
            { "binding_name": "#name_label", "binding_condition": "always" },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "(#name_label - 'index:_1' - 'index:_2' - 'index:_3' - 'index:_4' - 'index:_5')",
              "target_property_name": "#villager_name"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#villager_name - ':ws:' - ':ar:' - ':bt:' - ':ct:' - ':cl:' - ':fr:' - ':fs:' - ':fl:' - ':lt:' - ':lb:' - ':ms:' - ':sh:' - ':tl:') = #villager_name)",
              "target_property_name": "#is_renamed"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#name_label - #villager_name)",
              "target_property_name": "#villager_level"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "('#profession_' + #villager_name)",
              "target_property_name": "#texture"
            },
            { "binding_type": "view", "source_property_name": "(not #is_renamed)", "target_property_name": "#visible" }
          ]
        }
      },
      {
        "inventory_side_content@global.empty_panel": {
          "size": [171, 16],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "controls": [
            {
              "eyes@global.empty_panel": {
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "size": [160, 54],
                "controls": [
                  {
                    // underlays the others
                    "default@recolourful_villager.villager_eye_template": {
                      "layer": 3,
                      "texture": "assets/advanced_sprites/animated/villager/default/default",
                      "bindings": []
                    }
                  },
                  {
                    "weaponsmith@recolourful_villager.villager_eye_template": {
                      "texture": "assets/advanced_sprites/animated/villager/default/weaponsmith",
                      "uv": "@villager_animation.weaponsmith_eyes_0",
                      "$profession": "id::ws:"
                    }
                  },
                  {"armorer@recolourful_villager.villager_eye_template"      : {"texture": "assets/advanced_sprites/animated/villager/default/armorer"      ,  "$profession": "id::ar:"}},
                  {"cartographer@recolourful_villager.villager_eye_template" : {"texture": "assets/advanced_sprites/animated/villager/default/cartographer" ,  "$profession": "id::ct:"}},
                  {"farmer@recolourful_villager.villager_eye_template"       : {"texture": "assets/advanced_sprites/animated/villager/default/farmer"       ,  "$profession": "id::fr:"}},
                  {"fletcher@recolourful_villager.villager_eye_template"     : {"texture": "assets/advanced_sprites/animated/villager/default/fletcher"     ,  "$profession": "id::fl:"}}
                ]
              }
            },
            {
              "label_stack@global.empty_stack": {
                "orientation": "horizontal",
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "size": ["100%c", 10],
                "layer": 3,
                "controls": [
                  {
                    "profession@global.empty_label": {
                      "text": "#text",
                      "size": ["default", 10],
                      "localize": true,
                      "color": "$villager_name_color",
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "profession_bindings",
                          "source_property_name": "('atemp.entity.' + #villager_name + '.villager')",
                          "target_property_name": "#text"
                        },
                        {
                          "binding_type": "view",
                          "source_control_name": "profession_bindings",
                          "source_property_name": "(not #is_renamed)",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "profession_renamed@global.empty_label": {
                      "text": "#text",
                      "size": ["default", 10],
                      "localize": true,
                      "color": "$villager_name_color",
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "profession_bindings",
                          "source_property_name": "#villager_name",
                          "target_property_name": "#text"
                        },
                        {
                          "binding_type": "view",
                          "source_control_name": "profession_bindings",
                          "source_property_name": "#is_renamed",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "skill_level@global.empty_label": {
                      "text": "#text",
                      "size": ["default", 10],
                      "localize": true,
                      "color": "$villager_name_color",
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "profession_bindings",
                          "source_property_name": "('atemp.trade.' + #villager_level)",
                          "target_property_name": "#text"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "villager_eye_template@screen_content.image_element": {
    "layer": 4,
    "uv_size": [12, 5],
    "animation_reset_name": "screen_animation_reset",
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "size": [12, 5],
    "uv": "@villager_animation.default_eyes_0",
    "$source_property": "(#villager_name = $profession)",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "profession_bindings",
        "source_property_name": "$source_property",
        "target_property_name": "#visible"
      }
    ]
  }
}
