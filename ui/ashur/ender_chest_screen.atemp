{
  "namespace": "ender_chest_screen",
  "ender_chest@container_common.container_details": {
    "size": [176, 166],
    "$screen_controls": [
      { "common_panel@screen_content.ender_chest": {} },
      { "extensions@rcc-extensions.ender_chest_screen": {} },
      {
        "ender_eye@screen_content.image_element": {
          "texture": "assets/variants/animated/ender_eye.png",
          "uv_size": [10, 10],
          "size": [10, 10],
          "layer": 5,
          "offset": [0, 6],
          "anchor_to": "top_middle",
          "anchor_from": "top_middle",
          "animation_reset_name": "screen_animation_reset",
          "uv": "@eye_animation.eye_0",
          "disable_anim_fast_forward": true
        }
      },
      {
        "ender_chest_top_half@global.empty_stack": {
          "orientation": "vertical",
          "size": [176, 77],
          "anchor_to": "top_middle",
          "anchor_from": "top_middle",
          "controls": [
            { "filler_0@global.empty_panel": { "size": [176, 17] } },
            {
              "chest_grid_holder@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 54],
                "controls": [
                  { "filler_3@global.empty_panel": { "size": [7, "fill"] } },
                  {
                    "ender_chest_grid@global.empty_grid": {
                      "size": [162, 54],
                      "grid_dimensions": [9, 3],
                      "grid_item_template": "jc_container_item.container_item",
                      "$item_collection": "container_items",
                      "collection_name": "$item_collection"
                    }
                  },
                  { "filler_4@global.empty_panel": { "size": [7, "fill"] } }
                ]
              }
            }
          ]
        }
      },
      {
        "inventory_and_hotbar@container_common.container_bottom_section": {}
      }
    ]
  }
}
