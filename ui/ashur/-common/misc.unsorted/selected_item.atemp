{
  "namespace": "selected_item",
  "selected_item_details_factory": { "type": "factory", "control_name": "@selected_item.selected_item_details" },
  "selected_item_details@global.empty_image": {
    "anchor_to": "bottom_middle",
    "anchor_from": "bottom_middle",
    "size": ["100%cm", "100%cm"],
    "layer": 3000,
    "offset": [0, -16],
    "controls": [
      {
        "rarity@selected_item.mobile_tooltip_base": {
          "layer": 4
        }
      },
      {
        "no_rarity@selected_item.mobile_tooltip_base": {
          "layer": 2,
          "texture": "textures/common",
          "bindings": [
            { "binding_name": "#selected_hover_text" },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "(not (('%.2s' * #selected_hover_text) = '§'))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "anim_item_details_alpha": {
    "anim_type": "alpha",
    "easing": "in_quint",
    "destroy_at_end": "selected_item_details",
    "duration": 2,
    "from": "$hover_text_opacity",
    "to": 0
  },
  "mobile_tooltip_base@screen_content.image_element": {
    "size": ["100%c + 8px", "100%c + 8px"],
    "alpha": "@selected_item.anim_item_details_alpha",
    "nineslice_size": 3,
    "controls": [
      {
        "hover_text": {
          "type": "label",
          "size": ["default", "default"],
          "text": "#selected_hover_text",
          "alpha": "@selected_item.anim_item_details_alpha",
          "shadow": true,
          "localize": false,
          "bindings": [
            { "binding_name": "#selected_hover_text" },
            {
              "binding_type": "view",
              "binding_condition": "always_when_visible",
              "source_property_name": "#selected_hover_text",
              "target_property_name": "#hover_text"
            }
          ]
        }
      }
    ],
    "allow_debug_missing_texture": false,
    "property_bag": {
      "#item_rarity§f": "textures/common",
      "#item_rarity§e": "textures/uncommon",
      "#item_rarity§b": "textures/rare",
      "#item_rarity§d": "textures/epic"
    },
    "bindings": [
      { "binding_name": "#selected_hover_text" },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "('#item_rarity' + ('%.3s' * (#selected_hover_text - '§o')))",
        "target_property_name": "#texture"
      }
    ]
  }
}
