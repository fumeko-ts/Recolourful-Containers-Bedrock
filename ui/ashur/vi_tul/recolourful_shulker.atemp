{
  "namespace": "recolourful_shulker",
  //possibly the current best way of doing this (it i way less likely to break than the other version)
  "recolourful_shulker@global.empty_panel": {
    "size": [176, 166],
    "anchor_from": "center",
    "anchor_to": "center",
    "$container_name|default": "$container_title",
    "controls": [
      {
        "colors@screen_content.image_element": {
          "uv_size": [176, 166],
          "size": [176, 166],
          "$shulker_texture": "assets/advanced_sprites/shulker_box/default",
          "texture": "$shulker_texture",
          /*
            redstone chicken stay out of this file ik you been reading these if your going to yoink my code again atleast credit me this time
          */
          "variables": [
            {"requires":"(('%.6s' * $container_name) = '§f§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/white"      },
            {"requires":"(('%.6s' * $container_name) = '§p§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/orange"     },
            {"requires":"(('%.6s' * $container_name) = '§5§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/magenta"    },
            {"requires":"(('%.6s' * $container_name) = '§b§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/light_blue" },
            {"requires":"(('%.6s' * $container_name) = '§e§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/yellow"     },
            {"requires":"(('%.6s' * $container_name) = '§a§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/lime"       },
            {"requires":"(('%.6s' * $container_name) = '§d§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/pink"       },
            {"requires":"(('%.6s' * $container_name) = '§8§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/gray"       },
            {"requires":"(('%.6s' * $container_name) = '§7§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/light_gray" },
            {"requires":"(('%.6s' * $container_name) = '§3§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/cyan"       },
            {"requires":"(('%.6s' * $container_name) = '§u§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/purple"     },
            {"requires":"(('%.6s' * $container_name) = '§9§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/blue"       },
            {"requires":"(('%.6s' * $container_name) = '§n§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/brown"      },
            {"requires":"(('%.6s' * $container_name) = '§2§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/green"      },
            {"requires":"(('%.6s' * $container_name) = '§c§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/red"        },
            {"requires":"(('%.6s' * $container_name) = '§0§r')","$shulker_texture":"assets/advanced_sprites/shulker_box/black"      }
          ]
        }
      }
    ]
  }
}
