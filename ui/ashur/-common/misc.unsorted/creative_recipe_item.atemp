{
  "namespace": "creative_recipe_item",
  "recipe_container_item": {
    "type": "input_panel",
    "size": [18, 18],
    "$item_collection": "recipe_book",
    "focus_enabled": true,
    "focus_wrap_enabled": false,
    "focus_magnet_enabled": false,
    "controls": [
      {
        "item_cell@global.empty_panel": {
          "size": [18, 18],
          "controls": [
            {
              "slot@screen_content.image_element": {
                "size": ["default", "default"],
                "nineslice_size": [1, 1, 1, 1],
                "layer": 3,
                "texture": "assets/sprite_assets/container/slot"
              }
            },
            {
              "touch_selection@screen_content.image_element": {
                "size": [18, 18],
                "texture": "textures/ui/touch_ui_selected_slot",
                "nineslice_size": 1,
                "layer": 4,
                "ignored": "(not ($touch or $pocket_edition))",
                "bindings": [
                  {
                    "binding_name": "(#container_item_background_texture = 'textures/ui/recipe_book_touch_cell_selected')",
                    "binding_name_override": "#visible",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection"
                  }
                ]
              }
            },
            {
              "item@global.empty_panel": {
                "size": [18, 18],
                "controls": [
                  {
                    "item_renderer@container_item.item_renderer": {
                      "size": [16, 16],
                      "anchor_to": "center",
                      "anchor_from": "center",
                      "layer": 10
                    }
                  }
                ]
              }
            },
            {
              "group_icons@global.empty_panel": {
                "layer": 16,
                "controls": [
                  {
                    "item_overlay_contract@creative_recipe_item.item_overlay_image": {
                      "texture": "textures/ui/recipe_book_collapse_icon",
                      "$group_index": 1
                    }
                  },
                  {
                    "item_overlay_expand@creative_recipe_item.item_overlay_image": {
                      "texture": "textures/ui/recipe_book_expand_icon",
                      "$group_index": 2
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_name": "#container_item_modifier",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection",
                    "binding_condition": "visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "item_cell_button@button_mappings.creative_item_button": {
          "$dont_render_hover_text|default": false
        }
      }
    ]
  },
  "item_overlay_image": {
    "type": "image",
    "size": [7, 7],
    "offset": [-1, -1],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "group_icons",
        "resolve_sibling_scope": true,
        "source_property_name": "(#container_item_modifier = $group_index)",
        "target_property_name": "#visible"
      }
    ]
  }
}
