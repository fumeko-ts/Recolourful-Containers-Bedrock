{
  "namespace": "java_hover_text",
  "hover_text_renderer@global.empty_panel": {
    "ignored": "($touch or $dont_render_hover_text)",
    "layer": 290,
    "$hover_text_binding_name|default": "#hover_text",
    "controls": [
      {
        "hover_text_java@global.custom_renderer": {
          "allow_clipping": false,
          "$type": "bundle_tooltip_renderer",
          "controls": [
            {
              "items_with_rarity@global.empty_panel": {
                "size": ["200%c", "200%c"],
                "controls": [
                  {
                    "rarity@java_hover_text.tooltip_base": {}
                  }
                ]
              }
            },
            {
              "items_with_no_rarity@global.empty_panel": {
                "size": ["200%c", "200%c"],
                "controls": [
                  {
                    "no_rarity@java_hover_text.tooltip_base": {
                      "bindings": [],
                      "texture": "textures/common"
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_type": "view",
                    "binding_condition": "always",
                    "source_control_name": "hover_text_java",
                    "resolve_sibling_scope": true,
                    "source_property_name": "(not (('%.2s' * $hover_text_binding_name) = '§'))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "$hover_text_binding_name",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "(not ($hover_text_binding_name = ''))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "tooltip_base@screen_content.image_element": {
    "size": ["100%c + 8px", "100%c + 8px"],
    "offset": "$pc_tooltip_offset",
    "nineslice_size": 3,

    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",

    "alpha": "$hover_text_opacity",
    "controls": [
      {
        "hover_text": {
          "type": "label",
          "size": ["default", "default"],
          "layer": 30,
          "text": "#hover_text",
          "shadow": true,
          "bindings": [
            {
              "binding_name": "$hover_text_binding_name",
              "binding_name_override": "#hover_text",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection"
            }
          ]
        }
      }
    ],
    "allow_debug_missing_texture": false,
    "property_bag": {
      "#item_rarity§f": "textures/common",
      "#item_rarity§e": "textures/uncommon",
      "#item_rarity§b": "textures/rare",
      "#item_rarity§d": "textures/epic"
    },
    "bindings": [
      {
        "binding_name": "$hover_text_binding_name",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection"
      },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "('#item_rarity' + ('%.3s' * ($hover_text_binding_name - '§o')))",
        "target_property_name": "#texture"
      }
    ]
  }
}
