{
  "namespace": "crafting_screen",
  "screen_base@container_common.container_details": {
    "min_size": [176, 166],
    "max_size": [359, 166],
    "$screen_controls": [
      {
        "base_horizontal_Stack@global.empty_stack": {
          "orientation": "horizontal",
          "anchor_to": "center",
          "anchor_from": "center",
          "min_size": [176, 166],
          "max_size": [359, 166],
          "layer": 2,
          "controls": [
            {
              "recipe_book@recipe_book.recipe_book": {} //thats alot of recipe_books
            },
            {
              "inventory@global.empty_panel": {
                "size": [176, 166],
                "controls": [
                  { "extension@rcc-extensions.crafting_screen": {} },
                  { "common_panel@container_content.crafting_screen": {} },
                  {
                    "close@global.close_button": {
                      "offset": [14, -4],
                      "$pressed": "textures/ui/ashur/close_pressed",
                      "$default": "textures/ui/ashur/close_default",
                      "$hover": "textures/ui/ashur/close_hover"
                    }
                  },
                  {
                    "mobile_craft_holder@global.empty_panel": {
                      "size": [92, 56],
                      "anchor_from": "top_right",
                      "anchor_to": "top_right",
                      "controls": [
                        {
                          "craft_all_mobile": {
                            "type": "button",
                            "ignored": "(not ($touch or $pocket_edition or $pocket_screen))",
                            "default_control": "default",
                            "hover_control": "hover",
                            "pressed_control": "pressed",
                            "anchor_from": "bottom_left",
                            "anchor_to": "bottom_left",
                            "size": [35, 26],
                            "layer": 7,
                            "button_mappings": [
                              {
                                "from_button_id": "button.menu_select",
                                "mapping_type": "pressed",
                                "to_button_id": "button.crafting_output_tertiary"
                              }
                            ],
                            "property_bag": {
                              "#collection_index": 0,
                              "#collection_name": "crafting_output_items"
                            },
                            "controls": [
                              { "default@screen_content.mobile_easy_craft_table_default": {} },
                              { "pressed@screen_content.mobile_easy_craft_table_pressed": {} },
                              { "hover@screen_content.mobile_easy_craft_table_hover": {} }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "crafting_stack_wrapper@global.empty_stack": {
                      "orientation": "vertical",
                      "anchor_to": "top_left",
                      "anchor_from": "top_left",
                      "size": [176, 70],
                      "controls": [
                        { "crafting_top_margin@global.empty_panel": { "size": ["fill", 16] } },
                        {
                          "crafting_body_row@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [176, 54],
                            "controls": [
                              {
                                "left_column_stack@global.empty_stack": {
                                  "orientation": "vertical",
                                  "size": [29, 54],
                                  "controls": [
                                    { "toggle_top_spacing@global.empty_panel": { "size": ["fill", 12] } },
                                    {
                                      "toggle_row@global.empty_stack": {
                                        "orientation": "horizontal",
                                        "size": [29, 21],
                                        "controls": [
                                          { "toggle_left_margin@global.empty_panel": { "size": [5, "fill"] } },
                                          {
                                            "layout_toggle@global.empty_panel": {
                                              "size": [21, 21],
                                              "controls": [
                                                {
                                                  "recipe_toggle@crafting_common.recipe_layout_toggle": {
                                                    "bindings": [
                                                      {
                                                        "binding_type": "global",
                                                        "binding_condition": "always",
                                                        "binding_name": "(not #is_creative_mode)",
                                                        "binding_name_override": "#visible"
                                                      }
                                                    ]
                                                  }
                                                }
                                              ]
                                            }
                                          },
                                          { "toggle_right_margin@global.empty_panel": { "size": [4, "fill"] } }
                                        ]
                                      }
                                    },
                                    { "toggle_bottom_spacing@global.empty_panel": { "size": ["fill", 21] } }
                                  ]
                                }
                              },
                              {
                                "crafting_3x3_grid": {
                                  "type": "grid",
                                  "size": [54, 54],
                                  "anchor_from": "top_left",
                                  "anchor_to": "top_left",
                                  "grid_dimensions": [3, 3],
                                  "$item_collection": "crafting_input_items",
                                  "collection_name": "$item_collection",
                                  "grid_item_template": "crafting_textures.crafting_input_grid_item"
                                }
                              },
                              { "crafting_output_horizontal_spacer@global.empty_panel": { "size": [36, "fill"] } },
                              {
                                "output_stack@global.empty_stack": {
                                  "orientation": "vertical",
                                  "size": [26, 54],
                                  "controls": [
                                    { "output_top_spacing@global.empty_panel": { "size": ["fill", 14] } },
                                    {
                                      "crafting_output_holder@global.empty_panel": {
                                        "size": [26, 26],
                                        "controls": [
                                          {
                                            "output_item@container_item.container_item": {
                                              "size": [18, 18],
                                              "anchor_from": "center",
                                              "anchor_to": "center",
                                              "$item_collection": "crafting_output_items",
                                              "$button_ref": "button_mappings.crafting_output_button",
                                              "$stack_count_binding_condition": "always",
                                              "$item_renderer_binding_condition": "always",
                                              "$background_images": "crafting_textures.output_cell_textures"
                                            }
                                          }
                                        ]
                                      }
                                    },
                                    { "output_bottom_spacing@global.empty_panel": { "size": ["fill", 14] } }
                                  ]
                                }
                              },
                              { "crafting_stack_right_spacer@global.empty_panel": { "size": [31, "fill"] } }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "bottom_section@global.container_bottom_section": {}
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
