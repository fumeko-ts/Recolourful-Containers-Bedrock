{
  "namespace": "inventory_screen",
  "screen_base@container_common.container_details": {
    "min_size": [176, 166],
    "max_size": [359, 166],
    "anchor_to": "center",
    "anchor_from": "center",
    "$screen_controls": [
      {
        "survival_inventory@global.empty_stack": {
          "orientation": "horizontal",
          "min_size": [176, 166],
          "max_size": [359, 166],
          "layer": 1,
          "controls": [
            {
              "recipe_book@recipe_book.recipe_book": {} //thats alot of recipe_books
            },
            {
              "inventory@global.empty_panel": {
                "size": [176, 166],
                "controls": [
                  { "common_panel@container_content.inventory_screen": {} },
                  { "extensions@rcc-extensions.inventory_screen": {} },
                  {
                    "close@global.close_button": {
                      "offset": [14, -4],
                      "$pressed": "textures/ui/ashur/close_pressed",
                      "$default": "textures/ui/ashur/close_default",
                      "$hover": "textures/ui/ashur/close_hover"
                    }
                  },
                  {
                    "mobile_craft_holder@global.empty_panel": {
                      "size": [42, 47],
                      "anchor_from": "top_right",
                      "anchor_to": "top_right",
                      "controls": [
                        {
                          "craft_all_mobile": {
                            "type": "button",
                            "ignored": "(not ($touch or $pocket_edition or $pocket_screen))",
                            "default_control": "default",
                            "hover_control": "hover",
                            "pressed_control": "pressed",
                            "anchor_from": "bottom_left",
                            "anchor_to": "bottom_left",
                            "size": [17, 22],
                            "layer": 7,
                            "button_mappings": [
                              {
                                "from_button_id": "button.menu_select",
                                "mapping_type": "pressed",
                                "to_button_id": "button.crafting_output_tertiary"
                              }
                            ],
                            "property_bag": { "#collection_index": 0, "#collection_name": "crafting_output_items" },
                            "controls": [
                              { "default@screen_content.mobile_easy_craft_default": {} },
                              { "pressed@screen_content.mobile_easy_craft_pressed": {} },
                              { "hover@screen_content.mobile_easy_craft_hover": {} }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "cell_stack@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [79, 79],
                      "anchor_to": "top_right",
                      "anchor_from": "top_right",
                      "controls": [
                        { "buffer_1@global.empty_panel": { "size": ["fill", 17] } },
                        {
                          "cell_stack@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [79, 36],
                            "controls": [
                              {
                                "2x2_crafting_grid": {
                                  "type": "grid",
                                  "size": [36, 36],
                                  "grid_dimensions": [2, 2],
                                  "collection_name": "$item_collection",
                                  "$item_collection": "crafting_input_items",
                                  "$background_images": "crafting_textures.main_cell_panel",
                                  "$item_renderer_binding_condition": "always",
                                  "grid_item_template": "container_item.container_item"
                                }
                              },
                              { "buffer_2@global.empty_panel": { "size": [20, 36] } },
                              {
                                "cell_stack@global.empty_stack": {
                                  "orientation": "vertical",
                                  "size": [23, 36],
                                  "controls": [
                                    { "buffer_3@global.empty_panel": { "size": ["fill", 10] } },
                                    {
                                      "crafting_table_output_slot@container_item.container_item": {
                                        "$item_collection": "crafting_output_items",
                                        "$item_collection_name": "crafting_output_items",
                                        "$button_ref": "button_mappings.crafting_output_button",
                                        "$background_images": "crafting_textures.main_cell_panel",
                                        "$item_renderer_binding_condition": "always",
                                        "$stack_count_binding_condition": "always",
                                        "$cell_size": [18, 18]
                                      }
                                    },
                                    { "buffer_4@global.empty_panel": { "size": ["fill", 8] } }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        { "buffer_1@global.empty_panel": { "size": ["fill", 2] } },
                        {
                          "cell_stack@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [79, 18],
                            "controls": [
                              { "buffer_1@global.empty_panel": { "size": [7, "fill"] } },
                              { "recipe_toggle@crafting_common.recipe_layout_toggle": {} },
                              { "buffer_1@global.empty_panel": { "size": [52, "fill"] } }
                            ]
                          }
                        },
                        { "buffer_2@global.empty_panel": { "size": ["fill", 6] } }
                      ]
                    }
                  },
                  {
                    "stack_top_buffer_stack@global.empty_stack": {
                      "orientation": "vertical",
                      "anchor_to": "top_left",
                      "anchor_from": "top_left",
                      "size": [94, 86],
                      "controls": [
                        { "buffer_1@global.empty_panel": { "size": ["fill", 7] } },
                        {
                          "cell_stack@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [94, 79],
                            "controls": [
                              { "buffer_1@global.empty_panel": { "size": [7, "fill"] } },
                              {
                                "armor_grid": {
                                  "type": "grid",
                                  "size": [18, 72],
                                  "grid_dimensions": [1, 4],
                                  "$item_collection": "armor_items",
                                  "collection_name": "$item_collection",
                                  "controls": [
                                    {
                                      "head_grid_item@container_item.container_item": {
                                        "grid_position": [0, 0],
                                        "$cell_overlay_ref": "screen_content.armor_overlay_helmet",
                                        "$button_ref": "button_mappings.inventory_container_slot_button"
                                      }
                                    },
                                    {
                                      "chest_grid_item@container_item.container_item": {
                                        "grid_position": [0, 1],
                                        "$cell_overlay_ref": "screen_content.armor_overlay_chest",
                                        "$button_ref": "button_mappings.inventory_container_slot_button"
                                      }
                                    },
                                    {
                                      "legs_grid_item@container_item.container_item": {
                                        "grid_position": [0, 2],
                                        "$cell_overlay_ref": "screen_content.armor_overlay_legs",
                                        "$button_ref": "button_mappings.inventory_container_slot_button"
                                      }
                                    },
                                    {
                                      "feet_grid_item@container_item.container_item": {
                                        "grid_position": [0, 3],
                                        "$cell_overlay_ref": "screen_content.armor_image_feet",
                                        "$button_ref": "button_mappings.inventory_container_slot_button"
                                      }
                                    }
                                  ]
                                }
                              },
                              {
                                "player_renderer_holder@global.empty_panel": {
                                  "size": [51, 72],
                                  "controls": [
                                    {
                                      "player_float@global.empty_panel": {
                                        "size": [30, 80],
                                        "controls": [
                                          {
                                            "player_renderer": {
                                              "type": "custom",
                                              "size": [30, 80],
                                              "offset": [0, -14],
                                              "renderer": "live_player_renderer",
                                              "anchor_from": "center",
                                              "anchor_to": "center",
                                              "layer": 20,
                                              "animation_reset_name": "screen_animation_reset",
                                              "anims": [
                                                "@common.screen_exit_size_animation_push",
                                                "@common.screen_exit_size_animation_pop",
                                                "@common.screen_entrance_size_animation_push",
                                                "@common.screen_entrance_size_animation_pop"
                                              ],
                                              "property_bag": { "#look_at_cursor": true }
                                            }
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                }
                              },
                              {
                                "offhand_stack@global.empty_stack": {
                                  "orientation": "vertical",
                                  "size": [18, 72],
                                  "controls": [
                                    { "filler_panel@global.empty_panel": { "size": [18, 54] } },
                                    {
                                      "offhand_slot@container_item.container_item": {
                                        "$item_collection": "offhand_items",
                                        "$button_ref": "button_mappings.inventory_container_slot_button"
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "bottom_section@global.container_bottom_section": {}
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "(not #is_creative_mode)",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "creative_inventory@creative_inventory.screen_base": {
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "#is_creative_mode",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  }
}
